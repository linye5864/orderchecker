# 应用配置
APP_NAME=OrderComparer 后台任务服务
VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (SQLite 本地开发)
USE_SQLITE=true
SQLITE_PATH=./data/ordercomparer.db
DATABASE_URL=postgresql://user:pass@db:5432/recon  # 备用

# Redis 配置 (本地开发使用内存模拟)
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24小时

# Celery 配置 (同步执行用于本地开发)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_URL=redis://localhost:6379/0

# 文件存储配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600  # 100MB

# CORS 配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
